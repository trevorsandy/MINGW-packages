prepare() {
    # location is .../src
    export WD="$PWD"
    export MSYS2=1
    export MSYS=winsymlinks:lnk
    export MINGW_PREFIX="${MINGW_PREFIX}"
    export PLATFORM_PRETTY="MSYS2 ${MSYSTEM}"
    export PLATFORM_VER="${MSYSTEM}_${_platformid//-/.}"
    export LPUB3D="${_project}"
    export TARGET_CPU="$(uname -m)"
    export LDRAWDIR_ROOT="${WD}"
    export LDRAWDIR="${WD}/ldraw"
    export LP3D_NO_CLEANUP="true"
    export LP3D_NO_LOG_TAIL="true"
    export LP3D_NO_DEPS="true"
    export LP3D_LOG_PATH="${WD}"
    export LP3D_CPU_CORES="$(nproc)"
    export LP3D_QT5_BIN="${MINGW_PREFIX}/qt5-static/bin"
    export LP3D_3RD_DIST_DIR="${_3rdpartydistdir}"
    # create build folder
    [ ! -d "${srcdir}/${_shadowbuild}" ] && mkdir -p "${srcdir}/${_shadowbuild}" || :
    # create 3rd party assets folder
    [ ! -d "${LP3D_3RD_DIST_DIR}" ] && mkdir -p "${srcdir}/${LP3D_3RD_DIST_DIR}" || :
    # create 3rd party assets folder
    cd "${srcdir}/${_srcname}"
    # move ldraw archive libraries to LP3D_3RD_DIST_DIR and extras
    for LDrawLibFile in \
        ../complete.zip \
        ../lpub3dldrawunf.zip \
        ../tenteparts.zip \
        ../vexiqparts.zip; do
        if [ -f "${LDrawLibFile}" ]; then
            LIB_CMD=cp
            LIB_FILE="$(basename ${LDrawLibFile})"
            [ ! -f "../${LP3D_3RD_DIST_DIR}/${LIB_FILE}" ] && \
            ${LIB_CMD} -f ${LDrawLibFile} ../${LP3D_3RD_DIST_DIR}/ || :
            [ ! "${LIB_FILE}" = "complete.zip" ] && LIB_CMD=mv || :
            ${LIB_CMD} -f ${LDrawLibFile} mainApp/extras/
        fi
    done
    # update version.info commit sha
    LP3D_VER_INFO="builds/utilities/version.info"
    [ -f "${LP3D_VER_INFO}" ] && \
    sed -i "s/\w*$/${_sha:0:8}/" "${LP3D_VER_INFO}" || :
    # create renderers
    chmod a+x builds/utilities/CreateRenderers.sh && ./builds/utilities/CreateRenderers.sh
}

build() {
    cd "${srcdir}/${_srcname}"
    export MSYS=winsymlinks:lnk
    export MSYS2_ARG_CONV_EXCL="INSTALL_PREFIX="
    export PLATFORM_VER="${MSYSTEM}_${_platformid//-/.}"
    export PLATFORM_CODE="ap"
    export TARGET_VENDOR="MSYS2"
    export TARGET_CPU="$(uname -m)"
    # generate makefiles
    [ -d "${srcdir}/${_shadowbuild}" ] && \
    cd "${srcdir}/${_shadowbuild}"     && \
    ${MINGW_PREFIX}/qt5-static/bin/qmake.exe \
    PREFIX=${MINGW_PREFIX} \
    CONFIG-=debug_and_release \
    CONFIG+=osmesa \
    CONFIG+=msys \
    ../${_srcname}/LPub3D.pro || :
    # build package
    # make clean
    make -j$(nproc)
}

check() {
    cd "${srcdir}/${_shadowbuild}"
    TARGET_CPU="$(uname -m)"
    [[ "${TARGET_CPU}" = "x86_64" || "${TARGET_CPU}" = "aarch64" ]] && \
    LP3D_RELEASE="${PWD}/mainApp/64bit_release" || LP3D_RELEASE="${PWD}/mainApp/32bit_release"
    LP3D_3RDPARTY="${LP3D_RELEASE}/3rdParty"
    LDVIEW_="../${_3rdpartydistdir}/ldview-4.5/bin/${TARGET_CPU}"
    LDGLITE_="../${_3rdpartydistdir}/ldglite-1.3/bin/${TARGET_CPU}"
    POVRAY_="../${_3rdpartydistdir}/lpub3d_trace_cui-3.8/bin/${TARGET_CPU}"
	export MSYS2=1
    export LP3D_BUILD_OS=$(echo ${MSYSTEM} | awk '{print tolower($0)}')
    export LPUB3D_EXE=${LP3D_RELEASE}/lpub3d.exe
    export LDVIEW_EXE=${LP3D_RELEASE}/3rdParty/ldview-4.5/bin/ldview.exe
    export LDGLITE_EXE=${LP3D_RELEASE}/3rdParty/ldglite-1.3/bin/ldglite.exe
    export POVRAY_EXE=${LP3D_RELEASE}/3rdParty/lpub3d_trace_cui-3.8/bin/lpub3d_trace_cui.exe
    export SOURCE_DIR="${LP3D_RELEASE}"
    export LDRAWDIR="${srcdir}/ldraw"
    # setup 3rdParty folder
    if [ -f "${LDVIEW_}/ldview.exe" ]; then
	    [ ! -d "${LP3D_3RDPARTY}/ldview-4.5" ] && \
        mkdir -p ${LP3D_3RDPARTY}/ldview-4.5/bin || :
        cp -f ${LDVIEW_}/ldview.exe ${LP3D_3RDPARTY}/ldview-4.5/bin/
        cp -rf ${LDVIEW_}/../../resources/config ${LP3D_3RDPARTY}/ldview-4.5/
    fi
    if [ -f "${LDGLITE_}/ldglite.exe" ]; then
	    [ ! -d "${LP3D_3RDPARTY}/ldglite-1.3" ] && \
        mkdir -p ${LP3D_3RDPARTY}/ldglite-1.3/bin || :
        cp -f ${LDGLITE_}/ldglite.exe ${LP3D_3RDPARTY}/ldglite-1.3/bin/
    fi
    if [ -f "${POVRAY_}/lpub3d_trace_cui.exe" ]; then
        [ ! -d "${LP3D_3RDPARTY}/lpub3d_trace_cui-3.8" ] && \
		mkdir -p ${LP3D_3RDPARTY}/lpub3d_trace_cui-3.8/bin || :
        cp -f ${POVRAY_}/lpub3d_trace_cui.exe ${LP3D_3RDPARTY}/lpub3d_trace_cui-3.8/bin/
    fi
    # setup extras folder
    cp -rf ${srcdir}/${_srcname}/mainApp/extras ${LP3D_RELEASE}/ || :
    # setup build check folder
	[ ! -d "${LP3D_RELEASE}/builds" ] && \
	mkdir -p ${LP3D_RELEASE}/builds || :
    cp -rf ${srcdir}/${_srcname}/builds/check ${LP3D_RELEASE}/builds/
    if [ -f "${LPUB3D_EXE}" ]; then
        # perform dependency check
        ldd "${LPUB3D_EXE}" 2>/dev/null || :
        # perform build check
        (cd ${LP3D_RELEASE}/builds/check && chmod a+x build_checks.sh && ./build_checks.sh)
    fi
}

package() {
    cd "${srcdir}/${_shadowbuild}"
    make INSTALL_ROOT="${pkgdir}${MINGW_PREFIX}" install
}
