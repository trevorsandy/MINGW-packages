prepare() {
    # location is .../src
    export WD="$PWD"
    export MSYS2=1
    export MSYS=winsymlinks:lnk
    export MINGW_PREFIX="${MINGW_PREFIX}"
    export PLATFORM_PRETTY="MinGW-W64 MSYS2"
    export PLATFORM_VER="${_platformid//-/.}"
    export TARGET_CPU="$(uname -m)"
    export LPUB3D="${_project}"
    # Debug
    # export LDRAWDIR="${HOME}/ldraw" - restore
    export LDRAWDIR_ROOT="${WD}"
    export LDRAWDIR="${WD}/ldraw"
    export LP3D_NO_CLEANUP="true"
    export LP3D_NO_LOG_TAIL="true"
    # Debug end
    export LP3D_NO_DEPS="true"
    export LP3D_LOG_PATH="${WD}"
    export LP3D_CPU_CORES="$(nproc)"
    export LP3D_QT5_BIN="${MINGW_PREFIX}/qt5-static/bin"
    export LP3D_3RD_DIST_DIR="${_3rdpartydistdir}"
    # create build folder
    [ ! -d "${srcdir}/${_shadowbuild}" ] && mkdir -p "${srcdir}/${_shadowbuild}" || :
    # create 3rd party assets folder
    [ ! -d "${LP3D_3RD_DIST_DIR}" ] && mkdir -p "${srcdir}/${LP3D_3RD_DIST_DIR}" || :
    # create 3rd party assets folder
    cd "${srcdir}/${_srcname}"
    # move ldraw archive libraries to LP3D_3RD_DIST_DIR and extras
    for LDrawLibFile in \
        ../complete.zip \
        ../lpub3dldrawunf.zip \
        ../tenteparts.zip \
        ../vexiqparts.zip; do
        if [ -f "${LDrawLibFile}" ]; then
            LIB_CMD=cp
            LIB_FILE="$(basename ${LDrawLibFile})"
            [ ! -f "../${LP3D_3RD_DIST_DIR}/${LIB_FILE}" ] && \
            ${LIB_CMD} -f ${LDrawLibFile} ../${LP3D_3RD_DIST_DIR}/ || :
            [ ! "${LIB_FILE}" = "complete.zip" ] && LIB_CMD=mv || :
            ${LIB_CMD} -f ${LDrawLibFile} mainApp/extras/
        fi
    done
    # update version.info commit sha
    LP3D_VER_INFO="builds/utilities/version.info"
    [ -f "${LP3D_VER_INFO}" ] && \
    sed -i "s/\w*$/${_sha:0:8}/" "${LP3D_VER_INFO}" || :
    # create renderers
    chmod a+x builds/utilities/CreateRenderers.sh && ./builds/utilities/CreateRenderers.sh
}

build() {
    cd "${srcdir}/${_srcname}"
    export MSYS=winsymlinks:lnk
    export MSYS2_ARG_CONV_EXCL="INSTALL_PREFIX="
    export TARGET_VENDOR="MinGW-W64 MSYS2"
    export PLATFORM_CODE="ap"
    export PLATFORM_VER="${_platformid//-/.}"
    export TARGET_CPU="$(uname -m)"
    export LD_LIBRARY_PATH=${MINGW_PREFIX}/qt5-static/bin:${MINGW_PREFIX}/bin:$LD_LIBRARY_PATH
    # generate makefiles
	[ -d "${srcdir}/${_shadowbuild}" ] && cd "${srcdir}/${_shadowbuild}" || :
    ${MINGW_PREFIX}/qt5-static/bin/qmake.exe \
    PREFIX=${MINGW_PREFIX} \
    CONFIG-=debug_and_release \
    CONFIG+=build_check \
    CONFIG+=shared \
    CONFIG+=msys \
	../${_srcname}/LPub3D.pro \
	
    # build package
    # make clean
    make -j$(nproc)
}

check() {
    # check lpub3d dependencies
    cd "${srcdir}/${_shadowbuild}"
    [[ "${TARGET_CPU}" = "x86_64" || "${TARGET_CPU}" = "aarch64" ]] && \
    LP3D_RELEASE="64bit_release" || LP3D_RELEASE="32bit_release"
    LP3D_SUFFIX=$(cat builds/utilities/version.info | cut -d " " -f 1-2 | sed s/" "//g)
    LP3D_EXE="mainApp/${LP3D_RELEASE}/lpub3d${LP3D_SUFFIX}"
    [ -f "${LP3D_EXE}" ] && ldd ${LP3D_EXE} 2>/dev/null || :
}

package() {
    cd "${srcdir}/${_shadowbuild}"
    make INSTALL_ROOT="${pkgdir}${MINGW_PREFIX}" install
}
