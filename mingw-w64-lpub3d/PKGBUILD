_project=lpub3d-ci
_sha=ea4791586851b46804b16fc9b09ffb152efba93b
_srcname="${_project}-${_sha}"
_ldglite="ldglite"
_ldview="ldview"
_povray="povray"
_shadowbuild="sbuild"
_platformid="$(echo $(uname -a) | grep -oP "\b\d{4}-\d{2}-\d{2}\b")"
_3rdpartydistdir=lpub3d_msys_3rdparty
pkgver=2.4.9.4406
pkgrel=1
pkgbase=mingw-w64-${_project}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_project}")
pkgdesc='An LDraw Building Instruction Editor'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://trevorsandy.github.io/lpub3d'
msys2_repository_url='https://github.com/trevorsandy'
msys2_references=("cpe: cpe:/a:lpub3d:lpub3d")
license=('GPL3')
makedepends=(
    "unzip"
    "autoconf"
    "automake"
    "${MINGW_PACKAGE_PREFIX}-gcc"
    "${MINGW_PACKAGE_PREFIX}-make"
