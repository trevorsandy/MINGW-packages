    "${MINGW_PACKAGE_PREFIX}-freeglut"
    "${MINGW_PACKAGE_PREFIX}-boost-libs"
    "${MINGW_PACKAGE_PREFIX}-boost"
    "${MINGW_PACKAGE_PREFIX}-openexr"
    "${MINGW_PACKAGE_PREFIX}-SDL2"
    "${MINGW_PACKAGE_PREFIX}-libelf"
    "${MINGW_PACKAGE_PREFIX}-mesa"
    "${MINGW_PACKAGE_PREFIX}-llvm-libs"
    "${MINGW_PACKAGE_PREFIX}-llvm")

source=(
    "${_project}.tar.gz::${msys2_repository_url}/${_project}/archive/${_sha}.tar.gz"
    "${_povray}.tar.gz::${msys2_repository_url}/povray/archive/lpub3d/raytracer-cui.tar.gz"
    "${_ldview}.tar.gz::${msys2_repository_url}/ldview/archive/lpub3d-build.tar.gz"
    "${_ldglite}.tar.gz::${msys2_repository_url}/ldglite/archive/master.tar.gz"
