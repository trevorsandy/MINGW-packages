    "${msys2_repository_url}/lpub3d_libs/releases/download/v1.0.1/tenteparts.zip"
    "${msys2_repository_url}/lpub3d_libs/releases/download/v1.0.1/vexiqparts.zip")
noextract=(
    "${_povray}.tar.gz"
    "${_ldview}.tar.gz"
    "${_ldglite}.tar.gz"
    "complete.zip"
    "lpub3dldrawunf.zip"
    "tenteparts.zip"
    "vexiqparts.zip")
